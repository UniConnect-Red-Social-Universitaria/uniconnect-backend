
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url = env("DATABASE_URL")

}

model Usuario {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  nombre    String
  apellido  String
  correo    String   @unique
  contrasenaHash String
  carrera   String
  carreraId String? @db.ObjectId
  semestre  Int
  materiasCursando String[]
  correoVerificado Boolean @default(false)
  googleSub String?
  carreraCatalogo Carrera? @relation(fields: [carreraId], references: [id])
  solicitudesEnviadas Contacto[] @relation("Solicitante")
  solicitudesRecibidas Contacto[] @relation("Receptor")
  grupos UsuarioGrupo[]
  gruposCreados Grupo[] @relation("GruposCreados")
  mensajesEnviados Mensaje[] @relation("MensajesEnviados")
  mensajesRecibidos Mensaje[] @relation("MensajesRecibidos")
  eventosCreados Evento[] @relation("EventosCreados")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Carrera {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  nombre    String   @unique
  usuarios  Usuario[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Contacto {
  id            String         @id @default(auto()) @map("_id") @db.ObjectId
  solicitanteId String         @db.ObjectId
  receptorId    String         @db.ObjectId
  estado        EstadoContacto @default(PENDIENTE)
  solicitante   Usuario        @relation("Solicitante", fields: [solicitanteId], references: [id])
  receptor      Usuario        @relation("Receptor", fields: [receptorId], references: [id])
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@unique([solicitanteId, receptorId])
}

model Materia {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  nombre    String   @unique
  grupos    Grupo[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Grupo {
  id        String        @id @default(auto()) @map("_id") @db.ObjectId
  nombre    String
  materiaId String        @db.ObjectId
  creadorId String        @db.ObjectId
  materia   Materia       @relation(fields: [materiaId], references: [id])
  creador   Usuario       @relation("GruposCreados", fields: [creadorId], references: [id])
  miembros  UsuarioGrupo[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model UsuarioGrupo {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  usuarioId String   @db.ObjectId
  grupoId   String   @db.ObjectId
  usuario   Usuario  @relation(fields: [usuarioId], references: [id])
  grupo     Grupo    @relation(fields: [grupoId], references: [id])
  createdAt DateTime @default(now())

  @@unique([usuarioId, grupoId])
}

model Mensaje {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  contenido  String
  emisorId   String   @db.ObjectId
  receptorId String   @db.ObjectId
  emisor     Usuario  @relation("MensajesEnviados", fields: [emisorId], references: [id])
  receptor   Usuario  @relation("MensajesRecibidos", fields: [receptorId], references: [id])
  createdAt  DateTime @default(now())
}

model Evento {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  titulo      String
  descripcion String
  fechaEvento DateTime
  creadorId   String   @db.ObjectId
  creador     Usuario  @relation("EventosCreados", fields: [creadorId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum EstadoContacto {
  PENDIENTE
  ACEPTADA
}