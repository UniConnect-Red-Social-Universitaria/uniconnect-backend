
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url = env("DATABASE_URL")

}

model Usuario {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  nombre    String
  apellido  String
  correo    String   @unique
  contrasenaHash String
  carrera   String
  carreraId String? @db.ObjectId
  semestre  Int
  materiasCursando String[]
  correoVerificado Boolean @default(false)
  googleSub String?
  carreraCatalogo Carrera? @relation(fields: [carreraId], references: [id])
  solicitudesEnviadas Contacto[] @relation("Solicitante")
  solicitudesRecibidas Contacto[] @relation("Receptor")
  grupos UsuarioGrupo[]
  gruposCreados Grupo[] @relation("GruposCreados")
  gruposAdministrados Grupo[] @relation("GruposAdministrados")
  solicitudesGrupoEnviadas SolicitudGrupo[] @relation("SolicitudesGrupoEnviadas")
  mensajesEnviados Mensaje[] @relation("MensajesEnviados")
  mensajesRecibidos Mensaje[] @relation("MensajesRecibidos")
  mensajesGrupoEnviados GrupoMensaje[] @relation("MensajesGrupoEnviados")
  archivosGrupoSubidos GrupoArchivo[] @relation("ArchivosGrupoSubidos")
  eventosCreados Evento[] @relation("EventosCreados")
  foroPreguntas  ForoPregunta[]
  foroRespuestas ForoRespuesta[]
  foroVotos      ForoVoto[]
  encuestasCreadas Encuesta[]
  votosEncuesta   EncuestaVoto[]
  seriesEstudio   SesionEstudioSerie[]
  sesionesEstudio SesionEstudio[]
  recursosCreados Recurso[] @relation("RecursosCreados")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Carrera {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  nombre    String   @unique
  usuarios  Usuario[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Contacto {
  id            String         @id @default(auto()) @map("_id") @db.ObjectId
  solicitanteId String         @db.ObjectId
  receptorId    String         @db.ObjectId
  estado        EstadoContacto @default(PENDIENTE)
  solicitante   Usuario        @relation("Solicitante", fields: [solicitanteId], references: [id])
  receptor      Usuario        @relation("Receptor", fields: [receptorId], references: [id])
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@unique([solicitanteId, receptorId])
}

model Materia {
  id        String         @id @default(auto()) @map("_id") @db.ObjectId
  nombre    String         @unique
  grupos    Grupo[]
  preguntas ForoPregunta[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

model Grupo {
  id        String        @id @default(auto()) @map("_id") @db.ObjectId
  nombre    String
  materiaId String        @db.ObjectId
  creadorId String        @db.ObjectId
  administradorId String  @db.ObjectId
  estado    EstadoGrupo   @default(ACTIVO)
  materia   Materia       @relation(fields: [materiaId], references: [id])
  creador   Usuario       @relation("GruposCreados", fields: [creadorId], references: [id])
  administrador Usuario   @relation("GruposAdministrados", fields: [administradorId], references: [id])
  miembros  UsuarioGrupo[]
  solicitudesIngreso SolicitudGrupo[]
  mensajes  GrupoMensaje[]
  archivos  GrupoArchivo[]
  encuestas Encuesta[]
  recursos  Recurso[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model UsuarioGrupo {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  usuarioId String   @db.ObjectId
  grupoId   String   @db.ObjectId
  usuario   Usuario  @relation(fields: [usuarioId], references: [id])
  grupo     Grupo    @relation(fields: [grupoId], references: [id])
  createdAt DateTime @default(now())

  @@unique([usuarioId, grupoId])
}

model SolicitudGrupo {
  id            String                @id @default(auto()) @map("_id") @db.ObjectId
  solicitanteId String                @db.ObjectId
  grupoId       String                @db.ObjectId
  estado        EstadoSolicitudGrupo  @default(PENDIENTE)
  solicitante   Usuario               @relation("SolicitudesGrupoEnviadas", fields: [solicitanteId], references: [id])
  grupo         Grupo                 @relation(fields: [grupoId], references: [id])
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  @@unique([solicitanteId, grupoId])
}

model Mensaje {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  contenido  String
  emisorId   String   @db.ObjectId
  receptorId String   @db.ObjectId
  emisor     Usuario  @relation("MensajesEnviados", fields: [emisorId], references: [id])
  receptor   Usuario  @relation("MensajesRecibidos", fields: [receptorId], references: [id])
  createdAt  DateTime @default(now())
}

model GrupoMensaje {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  contenido  String
  grupoId    String   @db.ObjectId
  emisorId   String   @db.ObjectId
  grupo      Grupo    @relation(fields: [grupoId], references: [id])
  emisor     Usuario  @relation("MensajesGrupoEnviados", fields: [emisorId], references: [id])
  createdAt  DateTime @default(now())
}

model GrupoArchivo {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  nombre       String
  nombreFisico String
  ruta         String
  mimeType     String
  tamanoBytes  Int
  grupoId      String   @db.ObjectId
  subidoPorId  String   @db.ObjectId
  grupo        Grupo    @relation(fields: [grupoId], references: [id])
  subidoPor    Usuario  @relation("ArchivosGrupoSubidos", fields: [subidoPorId], references: [id])
  createdAt    DateTime @default(now())
}

model Evento {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  titulo      String
  descripcion String
  lugar       String?
  fechaEvento DateTime
  categoria   String   @default("otro")
  creadorId   String   @db.ObjectId
  creador     Usuario  @relation("EventosCreados", fields: [creadorId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ForoPregunta {
  id         String        @id @default(auto()) @map("_id") @db.ObjectId
  titulo     String
  contenido  String
  autorId    String        @db.ObjectId
  materiaId  String        @db.ObjectId
  autor      Usuario       @relation(fields: [autorId], references: [id])
  materia    Materia       @relation(fields: [materiaId], references: [id])
  respuestas ForoRespuesta[]
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
}

model ForoRespuesta {
  id          String     @id @default(auto()) @map("_id") @db.ObjectId
  contenido   String
  autorId     String     @db.ObjectId
  preguntaId  String     @db.ObjectId
  puntuacion  Int        @default(0)
  autor       Usuario    @relation(fields: [autorId], references: [id])
  pregunta    ForoPregunta @relation(fields: [preguntaId], references: [id])
  votos       ForoVoto[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model ForoVoto {
  id           String        @id @default(auto()) @map("_id") @db.ObjectId
  usuarioId    String        @db.ObjectId
  respuestaId  String        @db.ObjectId
  valor        Int
  usuario      Usuario       @relation(fields: [usuarioId], references: [id])
  respuesta    ForoRespuesta @relation(fields: [respuestaId], references: [id])
  createdAt    DateTime      @default(now())

  @@unique([usuarioId, respuestaId])
}

model Encuesta {
  id           String          @id @default(auto()) @map("_id") @db.ObjectId
  pregunta     String
  estado       EstadoEncuesta  @default(OPEN)
  chatId       String?         @db.ObjectId
  grupoId      String?         @db.ObjectId
  creadorId    String          @db.ObjectId
  autoCloseAt  DateTime?
  closedAt     DateTime?
  creador      Usuario         @relation(fields: [creadorId], references: [id])
  grupo        Grupo?          @relation(fields: [grupoId], references: [id])
  opciones     EncuestaOpcion[]
  votos        EncuestaVoto[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([estado, autoCloseAt])
  @@index([grupoId])
  @@index([chatId])
  @@index([creadorId, createdAt])
}

model EncuestaOpcion {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  encuestaId  String    @db.ObjectId
  texto       String
  orden       Int
  encuesta    Encuesta  @relation(fields: [encuestaId], references: [id])
  votos       EncuestaVoto[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([encuestaId])
  @@index([encuestaId, orden])
}

model EncuestaVoto {
  id           String         @id @default(auto()) @map("_id") @db.ObjectId
  encuestaId   String         @db.ObjectId
  opcionId     String         @db.ObjectId
  usuarioId    String         @db.ObjectId
  encuesta     Encuesta       @relation(fields: [encuestaId], references: [id])
  opcion       EncuestaOpcion @relation(fields: [opcionId], references: [id])
  usuario      Usuario        @relation(fields: [usuarioId], references: [id])
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@unique([encuestaId, usuarioId])
  @@index([encuestaId])
  @@index([opcionId])
  @@index([usuarioId])
}

model SesionEstudioSerie {
  id                  String                @id @default(auto()) @map("_id") @db.ObjectId
  titulo              String
  descripcion         String
  lugar               String
  frecuencia          FrecuenciaRecurrencia
  fechaInicio         DateTime
  fechaFin            DateTime
  recordatorioMinutos Int                   @default(30)
  creadorId           String                @db.ObjectId
  creador             Usuario               @relation(fields: [creadorId], references: [id])
  sesiones            SesionEstudio[]
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
}

model SesionEstudio {
  id                  String              @id @default(auto()) @map("_id") @db.ObjectId
  titulo              String
  descripcion         String
  lugar               String
  fecha               DateTime
  recordatorioMinutos Int                 @default(30)
  cancelada           Boolean             @default(false)
  modificada          Boolean             @default(false)
  recordatorioEnviado Boolean             @default(false)
  serieId             String              @db.ObjectId
  creadorId           String              @db.ObjectId
  serie               SesionEstudioSerie  @relation(fields: [serieId], references: [id])
  creador             Usuario             @relation(fields: [creadorId], references: [id])
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
}

enum FrecuenciaRecurrencia {
  DIARIA
  SEMANAL
  QUINCENAL
}

enum EstadoContacto {
  PENDIENTE
  ACEPTADA
  RECHAZADA
}

enum EstadoGrupo {
  ACTIVO
  PENDIENTE_TRANSFERENCIA
  CERRADO
}

enum EstadoSolicitudGrupo {
  PENDIENTE
  APROBADA
  RECHAZADA
}

enum EstadoEncuesta {
  OPEN
  CLOSED
}
model Recurso {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  titulo      String
  contenido   String
  tipo        String   @default("TEXTO")
  metadata    Json?    
  grupoId     String   @db.ObjectId
  creadorId   String   @db.ObjectId
  grupo       Grupo    @relation(fields: [grupoId], references: [id])
  creador     Usuario  @relation("RecursosCreados", fields: [creadorId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
