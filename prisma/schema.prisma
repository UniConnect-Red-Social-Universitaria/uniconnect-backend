
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")

}

model Usuario {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  nombre    String
  apellido  String
  correo    String   @unique
  carrera   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}